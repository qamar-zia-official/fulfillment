  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/bun": "latest",
    "@repo/eslint-config": "workspace:*",
    "eslint": "10.9.1",
    "@babel/preset-typescript": "8.0.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
