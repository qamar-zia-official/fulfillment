{
  "name": "@repo/api",
  "type": "module",
  "dependencies": {
    "hono": "^4.13.8",
    "@repo/db": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/validation": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/tasks": "workspace:*",
    "@repo/application": "workspace:*"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build ./src/server.ts --outdir ./dist --target bun",
