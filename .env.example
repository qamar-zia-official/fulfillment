# ---------------------------------------------------------------------------
# Kinetous Fulfillment Operations Platform - environment template
# ---------------------------------------------------------------------------
# Copy to `.env` at the repository root:
#
#   cp .env.example .env
#
# `.env` is gitignored. This template is committed and must never contain
# real secrets. It is the single source of truth for the whole monorepo.
#
# Which files read it, and why they load it explicitly:
#   packages/db/drizzle.config.ts   -> bun run db:*
#   apps/api/src/server.ts          -> bun run dev / bun run start
#   apps/web/next.config.js         -> next dev / next build
#   packages/tasks (dev script)     -> bun run dev (via --env-file)
#
# Turbo runs every task with cwd = the package directory, so a root .env is
# invisible unless something resolves it by walking up to the repo root.
#
# Precedence: real process env (Vercel / CI / Docker) > `.env` > defaults.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# SERVER-ONLY. Never expose any of these via a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Database (required) --------------------------------------------------
# PostgreSQL connection string. Local example:
#   postgresql://postgres:postgres@localhost:5432/kinetous_fulfillment
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinetous_fulfillment

# --- API (optional, has a default) ---------------------------------------
# Hono API listener port. MUST differ from the web dev port (3000).
API_PORT=4000

# --- Better Auth (required by apps/api) -----------------------------------
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# The origin the auth API is served from (the Hono API), not the dashboard.
BETTER_AUTH_URL=http://localhost:4000
# Origin of the dashboard. Better Auth must trust it for cross-origin cookie auth.
WEB_APP_URL=http://localhost:3000

# --- Integrations ---------------------------------------------------------
# All optional. Each becomes required only when the matching phase is built.
# TRIGGER_SECRET_KEY=
# SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# RESEND_API_KEY=
# THREE_PL_API_KEY=
# SHIPPO_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OPERATIONS AUTHORISATION
# ---------------------------------------------------------------------------
# Comma-separated emails permitted to read the exception queue and close entries
# on it. Better Auth allows anyone to register an account, so without this list
# any registered user could read every merchant's orders and exceptions.
#
# Unset or empty authorises NOBODY. That is deliberate: a missing variable here
# must not mean "allow everyone". A value of "*" would, if that is ever wanted,
# have to be written out longhand rather than falling out of an empty string.
OPERATOR_EMAILS=ops@example.com

# ---------------------------------------------------------------------------
# PUBLIC. Reachable by the browser bundle. NEVER put a secret behind these.
# ---------------------------------------------------------------------------

# Base URL the dashboard uses to call the Hono API.
NEXT_PUBLIC_API_URL=http://localhost:4000
